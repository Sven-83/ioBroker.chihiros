{
    "i18n": true,
    "type": "panel",
    "items": {
        "proxyHeader": {
            "type": "header",
            "text": "ESPHome Bluetooth proxy",
            "size": 3,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "proxyHost": {
            "type": "text",
            "label": "Proxy host or IP",
            "help": "proxy_host_help",
            "newLine": true,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 3,
            "xl": 3
        },
        "proxyKey": {
            "type": "password",
            "label": "API encryption key",
            "help": "proxy_key_help",
            "visible": true,
            "xs": 12,
            "sm": 6,
            "md": 5,
            "lg": 4,
            "xl": 4
        },
        "seenMinutes": {
            "type": "number",
            "label": "Missing after (minutes)",
            "help": "seen_minutes_help",
            "min": 1,
            "max": 60,
            "xs": 12,
            "sm": 6,
            "md": 3,
            "lg": 2,
            "xl": 2
        },
        "pollMinutes": {
            "type": "number",
            "label": "Read interval (minutes)",
            "help": "poll_minutes_help",
            "min": 1,
            "max": 60,
            "xs": 12,
            "sm": 6,
            "md": 3,
            "lg": 2,
            "xl": 2
        },
        "devicesHeader": {
            "type": "header",
            "text": "Devices",
            "size": 3,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "devicesHint": {
            "type": "staticText",
            "text": "devices_hint",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "devices": {
            "type": "table",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 10,
            "xl": 8,
            "uniqueColumns": [
                "mac"
            ],
            "items": [
                {
                    "type": "text",
                    "attr": "name",
                    "title": "Name",
                    "width": "30%",
                    "filter": false,
                    "sort": false,
                    "default": ""
                },
                {
                    "type": "select",
                    "attr": "type",
                    "title": "Type",
                    "width": "20%",
                    "filter": false,
                    "sort": false,
                    "default": "light",
                    "options": [
                        {
                            "label": "Light",
                            "value": "light"
                        },
                        {
                            "label": "Dosing pump",
                            "value": "doser"
                        },
                        {
                            "label": "CO2 controller",
                            "value": "co2"
                        },
                        {
                            "label": "Doctor",
                            "value": "doctor"
                        },
                        {
                            "label": "Fan",
                            "value": "fan"
                        }
                    ]
                },
                {
                    "type": "text",
                    "attr": "mac",
                    "title": "MAC address",
                    "width": "30%",
                    "filter": false,
                    "sort": false,
                    "default": "",
                    "validator": "/^([0-9a-fA-F]{2}[:-]?){5}[0-9a-fA-F]{2}$/.test(data.mac)",
                    "validatorErrorText": "mac_error",
                    "validatorNoSaveOnError": true
                },
                {
                    "type": "checkbox",
                    "attr": "seasonal",
                    "title": "Seasonal",
                    "width": "20%",
                    "filter": false,
                    "sort": false,
                    "default": false
                }
            ]
        }
    }
}
